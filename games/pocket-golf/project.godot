; Pocket Golf. SPDX-License-Identifier: GPL-3.0-or-later
config_version=5

[application]
config/name="Pocket Golf"
config/version="0.1.4"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/min_width=640
window/size/min_height=440

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.77,0.87,0.86,1)

[audio]
driver/enable_input=false
