; SPDX-License-Identifier: GPL-3.0-or-later
config_version=5
[application]
config/name="TrainerOS Bazaar"
config/version="0.0.24"
run/main_scene="res://transit.tscn"
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/image="res://assets/transit/transit-boot.png"
boot_splash/bg_color=Color(0.035,0.047,0.09,1)
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/mode=3
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=800
window/size/min_height=450
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=false
[audio]
driver/enable_input=false
